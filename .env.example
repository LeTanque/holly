LLM_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_BASE_URL=
# Optional. Omit for models that only allow default temperature (gpt-5, o-series, etc.)
# LLM_TEMPERATURE=0.7

# Voice (OpenAI-compatible audio APIs; proxied server-side — key never sent to the browser)
# LLM_STT_MODEL=whisper-1
# LLM_TTS_MODEL=tts-1
# LLM_TTS_VOICE=nova

PORT=3011
VITE_PORT=5199
# Opt-in HTTPS for Vite dev (microphone on phones over LAN). Default is HTTP on localhost.
# VITE_DEV_HTTPS=true
